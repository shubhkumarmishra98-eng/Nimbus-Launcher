{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimbus Launcher",
  "version": "1.0.0",
  "identifier": "dev.nimbus.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nimbus Launcher",
        "width": 1120,
        "height": 740,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
